  actor: 
  speaker_name_from: 0
  textbox_title: 
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: 'You almost tell her. About the tugging. About how sometimes you "wake up"
    and your shoes are on the wrong feet, or your lunchbox is empty even though you
    don''t remember eating. But your throats clamp shut. Big kids don''t talk about
    invisible friends who live in their bones. '
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
