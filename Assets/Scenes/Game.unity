  actor_name_from: 0
  actor: 
  speaker_name_from: 0
  textbox_title: 
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: 'At home, Dad''s too tired to play. You drag your socks on the carpet, waiting
    for him to look up, but - tug - suddenly, your legs sprint to your room without
    asking. Your heart pounds. You didn''t decide to run. It''s like another kid
    shoved you out of the way to steer. '
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
