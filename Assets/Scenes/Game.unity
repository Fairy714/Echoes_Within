  actor: Sketch
  speaker_name_from: 0
  textbox_title: 
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: "And she does. She writes down everything you\u2019re afraid to say aloud:
    how this feels like erasure. How the new wedding means the old love is gone for
    good. How you're still here, stuck between two homes, two selves, two timelines.\r"
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
  log_text: 1
  log_category: Default
  done_printing: 0
  no_voice_playing: 0
  done_voice_clip: 0
