  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: 'One day at school, your hands won''t stop shaking after math class. Not
    because of the test- because the other you panicked when the numbers got too
    jumbled, and now you''re left with their leftover scared. You stumbled to the
    nurse, claiming a stomachache because "my head has too many people in it" sounds
    babyish. '
  talking_beeps: {fileID: 0}
