  m_EditorClassIdentifier: 
  go_to_next_node: 1
  executed_from_load: 0
  actor_name_from: 0
  actor: 
  speaker_name_from: 0
  textbox_title: 
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: 'You sit in quiet and, with the guide of a steady voice, you begin to map
    the internal landscape. You don''t force doors open; you knock, and you wait.
    You start a journal, and you find entries in handwriting you don''t recognize,
    describing fears and memories that feel both alien and chillingly familiar. You
    are an archaeologist of your own soul, gently brushing the dust form artifacts
    of a past you had to forget to survive. '
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
  log_text: 1
  log_category: Default
