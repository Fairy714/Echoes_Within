  textbox_title: 
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: 'The invitation is met with resistance. The protectors don''t trust your
    newfound strength. The wounded ones are afraid to feel the pain directly. It''s
    a slow dance of trust, building safety within your own mind. You feel them not
    as seperate entities, but as intense emotions, as body memories, as waves of
    knowledge that crash over you. You learn to sit with them, to feel them fully
    without dissociating, without letting them take the wheel. You practice, over
    and over, until the barriers begin to soften. '
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
